# Copy to .env.local and fill in to load the art from Shopify.
# Token: Shopify admin > Settings > Apps and sales channels > Develop apps (or the Headless channel)
# > Storefront API access token. It is a public token, but keep .env.local out of git.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=
